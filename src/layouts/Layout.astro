---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Noto+Sans+SC:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      --bg-primary: #0a0e1a;
      --bg-card: rgba(15, 23, 42, 0.72);
      --accent-cyan: #00e5ff;
      --accent-purple: #a855f7;
      --accent-green: #34d399;
      --text-primary: #e2e8f0;
      --text-secondary: #94a3b8;
      --glass-border: rgba(255, 255, 255, 0.07);
      --font-mono: 'JetBrains Mono', monospace;
      --font-sans: 'Noto Sans SC', sans-serif;
      /* 流体间距：手机 → 平板 → 桌面 */
      --space-section: clamp(3rem, 6vw, 6rem);
      --space-card-gap: clamp(1rem, 2vw, 1.5rem);
      --space-card-pad: clamp(1.2rem, 2.5vw, 2rem);
      --radius-card: clamp(12px, 1.5vw, 16px);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: var(--font-sans);
      background: var(--bg-primary);
      color: var(--text-primary);
      overflow-x: hidden;
      min-height: 100vh;
    }
    section {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-section) clamp(1rem, 4vw, 2rem);
    }
    .section-title {
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: clamp(1.4rem, 3vw, 1.8rem);
      color: var(--text-primary);
      margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
      position: relative;
      padding-left: 1rem;
    }
    .section-title::before {
      content: '';
      position: absolute;
      left: 0; top: 50%;
      transform: translateY(-50%);
      width: 4px; height: 1.2em;
      background: linear-gradient(to bottom, var(--accent-cyan), var(--accent-purple));
      border-radius: 2px;
    }

    /* ===== 跟随鼠标的聚光灯卡片 ===== */
    .glow-card {
      position: relative;
      background: var(--bg-card);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-card);
      backdrop-filter: blur(12px);
      overflow: hidden;
      transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
    }
    .glow-card::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      opacity: 0;
      transition: opacity 0.3s;
      background: radial-gradient(
        350px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(0, 229, 255, 0.08),
        transparent 60%
      );
      pointer-events: none;
      z-index: 1;
    }
    .glow-card:hover::before { opacity: 1; }
    .glow-card:hover {
      border-color: rgba(0, 229, 255, 0.25);
      transform: translateY(-3px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>

<script>
  // 全局：为所有 .glow-card 绑定鼠标跟随光效
  document.addEventListener('mousemove', (e) => {
    document.querySelectorAll<HTMLElement>('.glow-card').forEach(card => {
      const rect = card.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width) * 100;
      const y = ((e.clientY - rect.top) / rect.height) * 100;
      card.style.setProperty('--mouse-x', `${x}%`);
      card.style.setProperty('--mouse-y', `${y}%`);
    });
  });
</script>
