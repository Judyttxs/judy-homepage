---
const events = [
  { year: "2020", text: "入学，写下第一行 Hello World", icon: "🎓" },
  { year: "2021", text: "首次参与开源项目，提交第一个 PR", icon: "🌱" },
  { year: "2022", text: "暑期实习，后端开发方向", icon: "💼" },
  { year: "2023", text: "搭建第一台 HomeLab 服务器", icon: "🖥️" },
  { year: "2024", text: "毕业，完成 IoT 平台毕设", icon: "🎉" },
  { year: "2025", text: "部署 Obsidian 同步系统，本站上线", icon: "🚀" },
];
---

<section>
  <h2 class="section-title">成长轨迹</h2>
  <div class="tl">
    {events.map((e, i) => (
      <div class="tl-item" style={`animation-delay:${i * 0.12}s`}>
        <span class="tl-icon">{e.icon}</span>
        <div class="glow-card tl-card">
          <span class="tl-year">{e.year}</span>
          <p>{e.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .tl {
    position: relative;
    padding-left: clamp(2.5rem, 5vw, 3.5rem);
  }
  .tl::before {
    content: '';
    position: absolute;
    left: clamp(0.8rem, 2vw, 1.2rem);
    top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--accent-cyan), var(--accent-purple));
    opacity: 0.25;
  }
  .tl-item {
    position: relative;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    opacity: 0;
    animation: slideIn 0.5s forwards;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateX(-16px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .tl-icon {
    position: absolute;
    left: calc(-1 * clamp(2.5rem, 5vw, 3.5rem) + 0.3rem);
    top: 0.3rem;
    font-size: 1.1rem;
  }
  .tl-card { padding: clamp(0.9rem, 2vw, 1.2rem) var(--space-card-pad); }
  .tl-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
  }
  .tl-card p {
    margin-top: 0.3rem;
    font-size: clamp(0.85rem, 1.5vw, 0.92rem);
    color: var(--text-secondary);
  }
</style>
