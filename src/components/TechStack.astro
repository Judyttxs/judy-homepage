---
// 严格 2×2 对称，每类统一 5 项
const categories = [
  {
    name: "编程语言",
    icon: "⌨️",
    items: [
      { name: "Go", level: 85 },
      { name: "Python", level: 90 },
      { name: "C / C++", level: 70 },
      { name: "JavaScript", level: 80 },
      { name: "SQL", level: 75 },
    ]
  },
  {
    name: "基础设施",
    icon: "🏗️",
    items: [
      { name: "Linux", level: 90 },
      { name: "Docker", level: 85 },
      { name: "Nginx", level: 80 },
      { name: "Cloudflare", level: 85 },
      { name: "Git", level: 90 },
    ]
  },
  {
    name: "前端开发",
    icon: "🎨",
    items: [
      { name: "Astro", level: 75 },
      { name: "Vue.js", level: 70 },
      { name: "HTML / CSS", level: 80 },
      { name: "Canvas", level: 65 },
      { name: "响应式设计", level: 80 },
    ]
  },
  {
    name: "数据 & 存储",
    icon: "💾",
    items: [
      { name: "MySQL", level: 80 },
      { name: "Redis", level: 70 },
      { name: "InfluxDB", level: 65 },
      { name: "MQTT", level: 75 },
      { name: "SQLite", level: 70 },
    ]
  },
];
---

<section>
  <h2 class="section-title">技术栈</h2>
  <div class="stack-grid">
    {categories.map(cat => (
      <div class="glow-card stack-card">
        <div class="cat-header">
          <span class="cat-icon">{cat.icon}</span>
          <span class="cat-name">{cat.name}</span>
        </div>
        <div class="bars">
          {cat.items.map(item => (
            <div class="bar-row">
              <div class="bar-label">
                <span>{item.name}</span>
                <span class="pct">{item.level}%</span>
              </div>
              <div class="bar-track">
                <div class="bar-fill" style={`--w:${item.level}%`}></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* 严格 2×2 网格 */
  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-card-gap);
  }
  @media (max-width: 640px) {
    .stack-grid { grid-template-columns: 1fr; }
  }
  .stack-card {
    padding: var(--space-card-pad);
  }
  .cat-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1.4rem;
  }
  .cat-icon { font-size: 1.4rem; }
  .cat-name {
    font-weight: 600;
    font-size: clamp(0.95rem, 1.8vw, 1.1rem);
    color: var(--accent-cyan);
  }
  .bars { display: flex; flex-direction: column; gap: 0.9rem; }
  .bar-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.8rem;
    margin-bottom: 0.3rem;
  }
  .pct { font-family: var(--font-mono); color: var(--text-secondary); font-size: 0.72rem; }
  .bar-track {
    height: 5px;
    background: rgba(255,255,255,0.04);
    border-radius: 3px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--accent-cyan), var(--accent-purple));
    border-radius: 3px;
    transition: width 1s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .bar-fill.on { width: var(--w); }
</style>

<script>
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.querySelectorAll('.bar-fill').forEach(b => b.classList.add('on'));
        obs.unobserve(e.target);
      }
    });
  }, { threshold: 0.25 });
  document.querySelectorAll('.stack-card').forEach(el => obs.observe(el));
</script>
